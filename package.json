{
  "name": "soundwave-app",
  "version": "1.0.0",
  "description": "SoundWave - AI-Powered Music Streaming Platform",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "cd client && npm run preview",
    "dev": "cd client && npm run dev",
    "install-client": "cd client && npm install",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "install-server": "cd server && npm install",
    "docker:db": "docker compose up -d"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.13",
    "pg": "^8.11.5",
    "serverless-http": "^3.2.0",
    "yt-search": "^2.13.1"
  },
  "keywords": [
    "music",
    "streaming",
    "pwa",
    "ai",
    "recommendations"
  ],
  "author": "SoundWave Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
