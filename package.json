{
  "name": "soundwave-app",
  "version": "1.0.0",
  "description": "SoundWave - AI-Powered Music Streaming Platform",
  "main": "index.js",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "cd client && npm run preview",
    "dev": "cd client && npm run dev",
    "install-client": "cd client && npm install",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "install-server": "cd server && npm install",
    "docker:db": "docker compose up -d"
  },
  "keywords": [
    "music",
    "streaming",
    "pwa",
    "ai",
    "recommendations"
  ],
  "author": "SoundWave Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
